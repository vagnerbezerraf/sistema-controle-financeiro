POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=scf
POSTGRES_PASSWORD=scf_dev_password
POSTGRES_DB=scf

DATABASE_URL="postgresql://scf:scf_dev_password@localhost:5432/scf?schema=public"

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=scf_redis_secret

# Keycloak (provedor OIDC no Docker; perfil `full`/`optional` do docker-compose)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_PORT=8080

API_PORT=3001
API_HOST=0.0.0.0
API_CORS_ORIGIN="http://localhost:3000,http://localhost:1420"
API_BASE_URL="http://localhost:3001"

JWT_SECRET="troque-esta-chave-por-uma-segura-em-producao-com-pelo-menos-32-bytes"
JWT_ACCESS_TTL=3600
JWT_REFRESH_TTL=1209600

# OIDC (provedor externo). Vazio => SSO desabilitado (MVP JWT local).
# OIDC_ISSUER_URL e a URL PUBLICA (navegador). No Docker, o host interno
# (keycloak:8080) e usado por OIDC_INTERNAL_ISSUER_URL para trocar o code.
OIDC_ISSUER_URL="http://localhost:8080/realms/scf"
OIDC_INTERNAL_ISSUER_URL=""
OIDC_CLIENT_ID_WEB="scf-web"
OIDC_CLIENT_ID_MOBILE="scf-mobile"
OIDC_CLIENT_ID="scf-desktop"
OIDC_CLIENT_SECRET=""
OIDC_REDIRECT_URI_WEB="http://localhost:3000/auth/callback"
OIDC_REDIRECT_URI_MOBILE="scf-mobile://auth/callback"
OIDC_REDIRECT_URI_DESKTOP="scf://auth/callback"
OIDC_SCOPES="openid profile email"

# MFA (TOTP)
MFA_ISSUER="SCF"
MFA_ISSUER_EMAIL="no-reply@scf.local"

# E-mail transacional (recuperacao de senha). Em dev aponte para o MailHog.
MAIL_ENABLED=false
MAIL_HOST="localhost"
MAIL_PORT=1025
MAIL_SECURE=false
MAIL_USER=""
MAIL_PASSWORD=""
MAIL_FROM="SCF <no-reply@scf.local>"

WEB_APP_URL="http://localhost:3000"
PASSWORD_RESET_TTL_MINUTES=60

# Logs estruturados (Pino)
LOG_LEVEL=info
LOG_PRETTY=false

# Observabilidade (OpenTelemetry + OTLP)
OTEL_ENABLED=false
OTEL_SERVICE_NAME=scf-api
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"
OTEL_METRIC_EXPORT_INTERVAL=60000

S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_BUCKET="scf-attachments"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""

NODE_ENV=development
TZ=America/Sao_Paulo
