# Ambiente dos testes E2E (apps/api). Carregado por test/e2e/utils/env.ts com
# `override: true`, entao estes valores vencem os do .env de desenvolvimento.
#
# O banco aponta para um database DEDICADO (scf_test) para que a suite possa
# truncar tabelas livremente sem tocar nos dados de desenvolvimento.
NODE_ENV=test
TZ=America/Sao_Paulo

DATABASE_URL="postgresql://scf:scf_dev_password@localhost:5432/scf_test?schema=public"

JWT_SECRET="scf-e2e-secret-com-pelo-menos-32-bytes"
JWT_ACCESS_TTL=3600
JWT_REFRESH_TTL=1209600

API_BASE_URL="http://localhost:3001"
API_CORS_ORIGIN="http://localhost:3000"

# Logs silenciosos para nao poluir a saida do runner.
LOG_LEVEL=silent
LOG_PRETTY=false
OTEL_ENABLED=false

# Sem envio de e-mail nem provedor OIDC nos testes.
MAIL_ENABLED=false
OIDC_ISSUER_URL=""
