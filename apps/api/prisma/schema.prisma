generator client {
  provider = "prisma-client-js"
  // Ponto resolvido pelo TypeScript via `@prisma/client` -> `.prisma/client`.
  // Com pnpm hoisted, o `.prisma` efetivo fica em `apps/node_modules/.prisma`
  // (compartilhado por api e worker); gerar em outro lugar deixa os tipos obsoletos.
  output   = "../../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CurrencyCode {
  BRL
  USD
  EUR
  ARS
  GBP
  JPY
}

enum FinancialSpaceState {
  active
  archived
}

enum FinancialSpaceRole {
  owner
  admin
  contributor
  viewer
}

enum MembershipStatus {
  active
  invited
  revoked
}

enum SpaceInviteStatus {
  pending
  accepted
  revoked
  expired
}

enum AccountType {
  checking
  savings
  cash
  wallet
  credit_card
  investment
}

enum CategoryType {
  income
  expense
  both
}

enum EntityState {
  active
  archived
}

enum TransactionType {
  income
  expense
  transfer
  adjustment
}

enum TransactionStatus {
  scheduled
  pending
  confirmed
  canceled
}

enum PostingDirection {
  debit
  credit
}

enum ObligationStatus {
  forecast
  pending
  partially_reconciled
  reconciled
  overdue
  ignored
  canceled
}

enum ImportBatchStatus {
  previewed
  committed
  undone
}

enum ImportBatchFormat {
  csv
  ofx
}

enum RuleMatchType {
  contains
  equals
  startsWith
}

model User {
  id              String       @id @default(uuid())
  email           String       @unique
  emailVerifiedAt DateTime?
  name            String?
  passwordHash    String?
  oidcSub         String?      @unique
  timezone        String       @default("America/Sao_Paulo")
  locale          String       @default("pt-BR")
  pictureUrl      String?
  mfaSecret       String?
  mfaEnabled      Boolean      @default(false)
  mfaRecoveryCodes String[]    @default([])
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  lastLoginAt     DateTime?
  memberships     Membership[]
  spaceInvitesSent SpaceInvite[] @relation("SpaceInvitesSent")
  auditLogs       AuditLog[]
  passwordResetTokens PasswordResetToken[]
  notificationPreference NotificationPreference?

  @@map("users")
}

model FinancialSpace {
  id              String               @id @default(uuid())
  name            String
  primaryCurrency CurrencyCode         @default(BRL)
  timezone        String               @default("America/Sao_Paulo")
  state           FinancialSpaceState  @default(active)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  version         Int                  @default(0)
  memberships     Membership[]
  accounts        Account[]
  categories      Category[]
  transactions    Transaction[]
  budgets         Budget[]
  goals           Goal[]
  auditLogs       AuditLog[]
  outboxEvents    OutboxEvent[]
  recurrenceRules RecurrenceRule[]
  obligations     Obligation[]
  importBatches   ImportBatch[]
  invites         SpaceInvite[]
  attachments     Attachment[]
  categorizationRules CategorizationRule[]
  exchangeRates   ExchangeRate[]

  @@unique([id])
  @@map("financial_spaces")
}

model Membership {
  id               String              @id @default(uuid())
  financialSpaceId String
  userId           String
  role             FinancialSpaceRole  @default(contributor)
  status           MembershipStatus    @default(active)
  invitedEmail     String?
  invitedAt        DateTime?
  inviteAcceptedAt DateTime?
  revokedAt        DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  financialSpace FinancialSpace @relation(fields: [financialSpaceId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([financialSpaceId, userId])
  @@index([userId, status])
  @@map("memberships")
}

model SpaceInvite {
  id               String             @id @default(uuid())
  financialSpaceId String
  email            String
  role             FinancialSpaceRole @default(contributor)
  status           SpaceInviteStatus  @default(pending)
  tokenHash        String             @unique
  invitedById      String
  expiresAt        DateTime
  acceptedAt       DateTime?
  revokedAt        DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  financialSpace FinancialSpace @relation(fields: [financialSpaceId], references: [id], onDelete: Cascade)
  invitedBy      User           @relation("SpaceInvitesSent", fields: [invitedById], references: [id], onDelete: Cascade)

  @@unique([financialSpaceId, email])
  @@index([email, status])
  @@map("space_invites")
}

model Account {
  id               String               @id @default(uuid())
  financialSpaceId String
  name             String
  type             AccountType
  currency         CurrencyCode         @default(BRL)
  initialBalance   Decimal              @default(0) @db.Decimal(19, 4)
  initialBalanceDate DateTime            @db.Date
  institution      String?
  branch           String?
  number           String?
  color            String?
  icon             String?
  state            EntityState          @default(active)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  version          Int                  @default(0)

  financialSpace FinancialSpace  @relation(fields: [financialSpaceId], references: [id], onDelete: Cascade)
  postings       Posting[]
  creditCards    CreditCard[]

  @@index([financialSpaceId, state, type])
  @@map("accounts")
}

model Category {
  id               String               @id @default(uuid())
  financialSpaceId String
  name             String
  type             CategoryType
  color            String?
  icon             String?
  parentId         String?
  state            EntityState          @default(active)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  version          Int                  @default(0)

  financialSpace FinancialSpace @relation(fields: [financialSpaceId], references: [id], onDelete: Cascade)
  parent         Category?      @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children       Category[]     @relation("CategoryHierarchy")
  transactions   Transaction[]
  budgets        Budget[]
  categorizationRules CategorizationRule[]

  @@unique([financialSpaceId, name, parentId])
  @@index([financialSpaceId, type, state])
  @@map("categories")
}

model Transaction {
  id               String               @id @default(uuid())
  financialSpaceId String
  type             TransactionType
  status           TransactionStatus    @default(confirmed)
  description      String
  notes            String?
  categoryId       String?
  currency         CurrencyCode         @default(BRL)
  totalAmount      Decimal              @db.Decimal(19, 4)
  effectiveDate    DateTime             @db.Date
  dueDate          DateTime?            @db.Date
  tags             String[]             @default([])
  version          Int                  @default(0)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  idempotencyKey   String?

  // Estorno formalizado: quando a transacao e revertida, `reversedAt` marca o
  // momento. A transacao de estorno aponta de volta via
  // `reversalOfTransactionId` (unico), e o original expoe `reversedByTransaction`.
  reversedAt              DateTime?
  reversalReason          String?
  reversalOfTransactionId String?              @unique

  // Compra parcelada: as N transacoes de uma mesma compra compartilham o
  // `installmentGroupId`; `installmentNumber` vai de 1 a `installmentCount`.
  installmentGroupId String?
  installmentNumber  Int?
  installmentCount   Int?

  financialSpace FinancialSpace @relation(fields: [financialSpaceId], references: [id], onDelete: Cascade)
  category       Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  postings       Posting[]
  reconciledObligation Obligation? @relation("ObligationReconciliation")
  reversalOfTransaction Transaction? @relation("TransactionReversal", fields: [reversalOfTransactionId], references: [id], onDelete: SetNull)
  reversedByTransaction Transaction? @relation("TransactionReversal")
  attachments          Attachment[]

  @@unique([financialSpaceId, idempotencyKey])
  @@index([financialSpaceId, effectiveDate, status, type])
  @@index([financialSpaceId, categoryId])
  @@index([installmentGroupId])
  @@map("transactions")
}

model Posting {
  id            String           @id @default(uuid())
  transactionId String
  accountId     String
  amount        Decimal          @db.Decimal(19, 4)
  direction     PostingDirection
  effectiveDate DateTime         @db.Date

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  account     Account     @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([accountId, effectiveDate])
  @@index([transactionId])
  @@map("postings")
}

model CreditCard {
  id               String         @id @default(uuid())
  accountId        String         @unique
  name             String
  limit            Decimal        @db.Decimal(19, 4)
  closingDay       Int
  dueDay           Int
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  account  Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  invoices Invoice[]

  @@map("credit_cards")
}

model Invoice {
  id            String           @id @default(uuid())
  creditCardId  String
  cycleStart    DateTime         @db.Date
  cycleEnd      DateTime         @db.Date
  closingDate   DateTime         @db.Date
  dueDate       DateTime         @db.Date
  totalAmount   Decimal          @default(0) @db.Decimal(19, 4)
  paidAmount    Decimal          @default(0) @db.Decimal(19, 4)
  status        String
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  creditCard   CreditCard @relation(fields: [creditCardId], references: [id], onDelete: Cascade)

  @@index([creditCardId, cycleStart, status])
  @@map("invoices")
}

model RecurrenceRule {
  id               String               @id @default(uuid())
  financialSpaceId String
  frequency        String
  interval         Int                  @default(1)
  startDate        DateTime             @db.Date
  endDate          DateTime?            @db.Date
  occurrencesLimit Int?
  template         Json
  timezone         String               @default("America/Sao_Paulo")
  state            EntityState          @default(active)
  version          Int                  @default(0)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  financialSpace FinancialSpace @relation(fields: [financialSpaceId], references: [id], onDelete: Cascade)
  obligations    Obligation[]

  @@map("recurrence_rules")
}

model Obligation {
  id               String               @id @default(uuid())
  financialSpaceId String
  recurrenceRuleId String?
  status           ObligationStatus     @default(forecast)
  type             String
  description      String
  currency         CurrencyCode         @default(BRL)
  amount           Decimal              @db.Decimal(19, 4)
  dueDate          DateTime             @db.Date
  transactionId    String?              @unique
  version          Int                  @default(0)

  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  financialSpace      FinancialSpace @relation(fields: [financialSpaceId], references: [id], onDelete: Cascade)
  recurrenceRule      RecurrenceRule? @relation(fields: [recurrenceRuleId], references: [id], onDelete: SetNull)
  reconciledTransaction Transaction?  @relation("ObligationReconciliation", fields: [transactionId], references: [id], onDelete: SetNull)

  // Uma ocorrência por regra e vencimento: e o que torna a materializacao das
  // recorrencias idempotente (a reexecucao nao duplica obrigacoes).
  @@unique([recurrenceRuleId, dueDate])
  @@index([financialSpaceId, dueDate, status])
  @@map("obligations")
}

model Budget {
  id               String       @id @default(uuid())
  financialSpaceId String
  periodStart      DateTime     @db.Date
  periodEnd        DateTime     @db.Date
  categoryId       String?
  amountLimit      Decimal      @db.Decimal(19, 4)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  financialSpace FinancialSpace @relation(fields: [financialSpaceId], references: [id], onDelete: Cascade)
  category       Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@unique([financialSpaceId, periodStart, periodEnd, categoryId])
  @@map("budgets")
}

model Goal {
  id               String               @id @default(uuid())
  financialSpaceId String
  name             String
  targetAmount     Decimal              @db.Decimal(19, 4)
  currentAmount    Decimal              @default(0) @db.Decimal(19, 4)
  deadline         DateTime?            @db.Date
  color            String?
  icon             String?
  state            EntityState          @default(active)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  financialSpace FinancialSpace @relation(fields: [financialSpaceId], references: [id], onDelete: Cascade)

  @@map("goals")
}

// Lote de importacao de extrato (CSV ou OFX). Guarda o texto de origem para
// permitir auditoria e para reexecutar o commit idempotente, e os ids das
// transacoes criadas para permitir desfazer (cancelamento logico).
model ImportBatch {
  id               String            @id @default(uuid())
  financialSpaceId String
  accountId        String
  status           ImportBatchStatus @default(previewed)
  format           ImportBatchFormat @default(csv)
  fileName         String?
  sourceText       String
  rowCount         Int               @default(0)
  validCount       Int               @default(0)
  invalidCount     Int               @default(0)
  duplicateCount   Int               @default(0)
  importedCount    Int               @default(0)
  createdTransactionIds String[]     @default([])
  committedAt      DateTime?
  undoneAt         DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  financialSpace FinancialSpace @relation(fields: [financialSpaceId], references: [id], onDelete: Cascade)

  @@index([financialSpaceId, status, createdAt])
  @@map("import_batches")
}

model IdempotencyRecord {
  id               String   @id @default(uuid())
  financialSpaceId String
  idempotencyKey   String
  clientId         String?
  requestFingerprint String
  responsePayload  Json
  createdAt        DateTime @default(now())
  expiresAt        DateTime?

  @@unique([financialSpaceId, idempotencyKey])
  @@index([expiresAt])
  @@map("idempotency_records")
}

model AuditLog {
  id               String   @id @default(uuid())
  financialSpaceId String?
  userId           String?
  correlationId    String?
  operation        String
  entityType       String
  entityId         String
  safeSummary      Json
  createdAt        DateTime @default(now())

  financialSpace FinancialSpace? @relation(fields: [financialSpaceId], references: [id], onDelete: SetNull)
  user           User?           @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([financialSpaceId, entityType, createdAt])
  @@index([userId, createdAt])
  @@map("audit_logs")
}

model OutboxEvent {
  id               String   @id @default(uuid())
  financialSpaceId String
  eventType        String
  payload          Json
  status           String   @default("pending")
  publishedAt      DateTime?
  attempts         Int      @default(0)
  nextAttemptAt    DateTime?
  lastError        String?
  createdAt        DateTime @default(now())

  financialSpace FinancialSpace @relation(fields: [financialSpaceId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@map("outbox_events")
}

// Token de recuperacao de senha. Guardamos apenas o hash (SHA-256) do token;
// o valor em claro so existe no e-mail enviado ao usuario.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// Preferencias de notificacao e privacidade do usuario (uma linha por usuario).
// A matriz de canais por tipo de notificacao fica em JSON para nao exigir uma
// coluna por combinacao; o dominio normaliza e completa os padroes na leitura.
model NotificationPreference {
  id                String   @id @default(uuid())
  userId            String   @unique
  channels          Json
  quietHoursEnabled Boolean  @default(false)
  quietHoursStart   String   @default("22:00")
  quietHoursEnd     String   @default("07:00")
  includeAmounts    Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

// Comprovantes (recibos/documentos) anexados a uma transacao. O arquivo fica no
// storage (identificado por `storageKey`); aqui guardamos so os metadados e o
// `checksum` (SHA-256) do conteudo, para auditoria e deduplicacao.
model Attachment {
  id               String   @id @default(uuid())
  financialSpaceId String
  transactionId    String
  fileName         String
  contentType      String
  size             Int
  storageKey       String
  checksum         String
  uploadedBy       String?
  createdAt        DateTime @default(now())

  financialSpace FinancialSpace @relation(fields: [financialSpaceId], references: [id], onDelete: Cascade)
  transaction    Transaction    @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([financialSpaceId, transactionId])
  @@index([financialSpaceId, checksum])
  @@map("attachments")
}

// Taxa de cambio entre duas moedas do espaco (Fase 5, multiplas moedas). Uma
// taxa vale a partir de `asOf` (inclusive) ate ser substituida por outra taxa
// mais recente do mesmo par; a conversao de totais consolidados usa a taxa
// vigente na data do lancamento. Metricas por par: `rate` = quantas unidades de
// `toCurrency` valem 1 de `fromCurrency`.
model ExchangeRate {
  id               String       @id @default(uuid())
  financialSpaceId String
  fromCurrency     CurrencyCode
  toCurrency       CurrencyCode
  rate             Decimal      @db.Decimal(19, 4)
  asOf             DateTime     @db.Date
  source           String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  version          Int          @default(0)

  financialSpace FinancialSpace @relation(fields: [financialSpaceId], references: [id], onDelete: Cascade)

  @@unique([financialSpaceId, fromCurrency, toCurrency, asOf])
  @@map("exchange_rates")
}

// Regras de categorizacao automatica (Fase 5): casam a descricao do lancamento
// por um padrao textual e atribuem uma categoria. A precedencia e por `priority`
// (menor primeiro). As regras sao aplicadas no commit da importacao e por uma
// acao retroativa explicita aos lancamentos ainda sem categoria.
model CategorizationRule {
  id               String          @id @default(uuid())
  financialSpaceId String
  name             String
  matchType        RuleMatchType
  pattern          String
  categoryId       String
  type             TransactionType?
  priority         Int             @default(100)
  state            EntityState     @default(active)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  version          Int             @default(0)

  financialSpace FinancialSpace @relation(fields: [financialSpaceId], references: [id], onDelete: Cascade)
  category       Category       @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([financialSpaceId, state, priority])
  @@index([financialSpaceId, categoryId])
  @@map("categorization_rules")
}
