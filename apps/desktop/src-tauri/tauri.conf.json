{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SCF",
  "version": "0.1.0",
  "identifier": "app.scf.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter @scf/desktop exec vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm --filter @scf/desktop exec vite build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "SCF — Controle Financeiro",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "maximizable": true,
        "minimizable": true,
        "closable": true,
        "decorations": true,
        "transparent": false,
        "acceptFirstMouse": true,
        "contentProtected": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://localhost:* ws://localhost:* ipc: http: https:; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' data: https:; font-src 'self' data:;",
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Finance",
    "shortDescription": "Sistema de Controle Financeiro",
    "longDescription": "SCF e uma plataforma de controle financeiro pessoal e familiar com separacao explicita entre realizado, comprometido e projetado.",
    "copyright": "© SCF",
    "windows": {
      "wix": {
        "language": "pt-BR",
        "template": "WixUI_Minimal"
      },
      "nsis": {
        "languages": ["PortugueseBrazil"],
        "installerIcon": "icons/icon.ico"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    }
  }
}
