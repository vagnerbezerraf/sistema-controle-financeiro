{
  "extends": "@scf/config/tsconfig.react.json",
  "compilerOptions": {
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@api/*": ["../../packages/api-contracts/src/*"],
      "@tokens/*": ["../../packages/design-tokens/src/*"]
    },
    "types": ["node", "vite/client", "@tauri-apps/api"]
  },
  "include": ["src", "src-tauri/**/*.ts"],
  "exclude": ["node_modules", "dist", "src-tauri/target"]
}
