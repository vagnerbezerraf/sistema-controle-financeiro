    "@scf/validation": "workspace:*",
    "@tanstack/react-query": "^5.56.0",
    "clsx": "^2.1.0",
    "date-fns": "^4.1.0",
    "dinero.js": "^2.0.0",
    "lucide-react": "^0.441.0",
    "next": "^15.0.0",
    "qrcode.react": "^4.2.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-hook-form": "^7.53.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@scf/config": "workspace:*",
